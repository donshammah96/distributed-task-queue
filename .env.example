# Environment configuration for Distributed Task Queue & Scheduler

# Broker Selection: bullmq | nats | memory
BROKER_ADAPTER=bullmq

# PostgreSQL (Transactional Outbox, DLQ, Idempotency, Execution Logs)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dtq_db?schema=public

# Redis 7+ (BullMQ primary broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# NATS JetStream (High-throughput broker)
NATS_SERVERS=nats://localhost:4222
NATS_USER=
NATS_PASSWORD=

# API Control Plane Server
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Worker Node Settings
WORKER_CONCURRENCY=10
WORKER_USE_THREADS=true
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_LOCK_DURATION_MS=30000

# Outbox Relay Poller Settings
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_RETRIES=5

# Observability (Prometheus & OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=distributed-task-queue
PROMETHEUS_METRICS_PORT=9090
LOG_LEVEL=info

# Dashboard (Next.js 15)
NEXT_PUBLIC_API_URL=http://localhost:4000
