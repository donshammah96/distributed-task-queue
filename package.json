{
  "name": "distributed-task-queue",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade fault-tolerant distributed task queue and cron scheduler",
  "license": "MIT",
  "author": "Don Shammah <donshammah96@gmail.com>",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "dev": "turbo run dev --parallel",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "db:generate": "pnpm --filter @dtq/database db:generate",
    "db:push": "pnpm --filter @dtq/database db:push",
    "db:migrate": "pnpm --filter @dtq/database db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
